@using ERP.AI.Services
@{ ViewData["Title"] = "Assistente IA"; var resposta = ViewData["Resposta"] as RagResponse; var pergunta = ViewData["Pergunta"]?.ToString() ?? ""; }
<div class="module-page">
    <header class="module-header"><div><div class="module-breadcrumb"><span>ERP AI</span><i class="bi bi-chevron-right"></i><span>Inteligência</span><i class="bi bi-chevron-right"></i><strong>Assistente IA</strong></div><h1>Assistente inteligente</h1><p>Consulte dados e políticas do ERP com respostas contextualizadas e rastreáveis.</p></div><span class="ai-mode"><i class="bi bi-stars"></i>Modo demonstração</span></header>
    <div class="assistant-layout">
        <aside class="module-card assistant-sidebar"><button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Nova conversa</button><div class="assistant-group"><span>HOJE</span><button class="active"><i class="bi bi-chat-left-text"></i><span>Política de descontos</span></button><button><i class="bi bi-chat-left-text"></i><span>Clientes em atraso</span></button></div><div class="assistant-group"><span>RECENTES</span><button><i class="bi bi-chat-left-text"></i><span>Resumo financeiro</span></button><button><i class="bi bi-chat-left-text"></i><span>Validação de NF-e</span></button></div></aside>
        <section class="module-card assistant-chat">
            <div class="assistant-intro"><div class="assistant-logo"><i class="bi bi-robot"></i></div><h2>Como posso ajudar?</h2><p>Faça perguntas sobre clientes, pedidos, regras comerciais, documentos e indicadores do ERP.</p><div class="assistant-suggestions"><button onclick="document.getElementById('pergunta').value=this.innerText">Qual é o limite de desconto?</button><button onclick="document.getElementById('pergunta').value=this.innerText">Resuma os títulos em atraso</button><button onclick="document.getElementById('pergunta').value=this.innerText">Quais evidências foram usadas?</button></div></div>
            @if (resposta is not null) { <div class="assistant-conversation"><div class="assistant-question"><strong>Você</strong><p>@pergunta</p></div><div class="assistant-answer"><strong><i class="bi bi-stars"></i> ERP AI</strong><p>@resposta.Resposta</p><div class="assistant-sources"><span>Fontes consultadas</span>@foreach (var fonte in resposta.Fontes) { <div><i class="bi bi-file-earmark-text"></i><span><strong>@fonte.Titulo</strong><small>@fonte.Referencia · relevância @fonte.Relevancia.ToString("P0")</small></span></div> }</div></div></div> }
            <form asp-action="Assistente" method="post" class="assistant-composer"><textarea id="pergunta" name="pergunta" rows="2" placeholder="Pergunte algo sobre o ERP..." required>@pergunta</textarea><div><span><i class="bi bi-shield-check"></i> Respostas com evidências</span><button class="btn btn-primary"><i class="bi bi-send"></i></button></div></form>
        </section>
    </div>
</div>
