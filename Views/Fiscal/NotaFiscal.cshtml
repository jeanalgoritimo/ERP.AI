@section Scripts {

    <script>

        // =====================================================
        // VARIÁVEIS
        // =====================================================

        let xmlDocument = null;


        // =====================================================
        // SELECIONAR XML
        // =====================================================

        function selecionarXml() {

            document
                .getElementById("xmlFile")
                .click();

        }


        // =====================================================
        // XML SELECIONADO
        // =====================================================

        function xmlSelecionado(input) {

            if (!input.files || !input.files.length) {
                return;
            }

            const file = input.files[0];

            if (!file.name.toLowerCase().endsWith(".xml")) {

                alert("Selecione um arquivo XML válido.");

                input.value = "";

                return;
            }


            const reader = new FileReader();


            reader.onload = function (event) {

                try {

                    const xmlText = event.target.result;

                    processarXml(
                        xmlText,
                        file.name
                    );

                }
                catch (error) {

                    console.error(error);

                    alert(
                        "Não foi possível processar o XML."
                    );

                }

            };


            reader.onerror = function () {

                alert(
                    "Erro ao ler o arquivo XML."
                );

            };


            reader.readAsText(file);

        }


        // =====================================================
        // PROCESSAR XML
        // =====================================================

        function processarXml(
            xmlText,
            fileName
        ) {

            const parser =
                new DOMParser();


            const xml =
                parser.parseFromString(
                    xmlText,
                    "text/xml"
                );


            const parserError =
                xml.querySelector("parsererror");


            if (parserError) {

                alert(
                    "O arquivo selecionado não possui um XML válido."
                );

                return;

            }


            xmlDocument = xml;


            extrairIdentificacao(xml);

            extrairFornecedor(xml);

            extrairProdutos(xml);


            document
                .getElementById("xmlFileName")
                .innerText = fileName;


            document
                .getElementById("xmlFileDescription")
                .innerText =
                "NF-e carregada e processada com sucesso";


            document
                .getElementById("xmlLoaded")
                .classList.remove("d-none");


            console.log(
                "XML processado com sucesso."
            );

        }


        // =====================================================
        // IDENTIFICAÇÃO
        // =====================================================

        function extrairIdentificacao(xml) {

            const infNFe =
                xml.querySelector("infNFe");


            if (!infNFe) {

                console.warn(
                    "infNFe não encontrado."
                );

                return;

            }


            const numero =
                getXmlValue(
                    infNFe,
                    "nNF"
                );


            const serie =
                getXmlValue(
                    infNFe,
                    "serie"
                );


            let data =
                getXmlValue(
                    infNFe,
                    "dhEmi"
                );


            if (!data) {

                data =
                    getXmlValue(
                        infNFe,
                        "dEmi"
                    );

            }


            const chave =
                infNFe.getAttribute("Id");


            setValue(
                "numeroNota",
                numero
            );


            setValue(
                "serieNota",
                serie
            );


            if (data) {

                setValue(
                    "dataEmissao",
                    data.substring(0, 10)
                );

            }


            if (chave) {

                setValue(
                    "chaveNota",
                    formatarChave(
                        chave.replace("NFe", "")
                    )
                );

            }

        }


        // =====================================================
        // FORNECEDOR
        // =====================================================

        function extrairFornecedor(xml) {

            const emit =
                xml.querySelector("emit");


            if (!emit) {
                return;
            }


            const nome =
                getXmlValue(
                    emit,
                    "xNome"
                );


            const cnpj =
                getXmlValue(
                    emit,
                    "CNPJ"
                );


            const uf =
                getXmlValue(
                    emit,
                    "UF"
                );


            const municipio =
                getXmlValue(
                    emit,
                    "xMun"
                );


            setValue(
                "fornecedorNome",
                nome
            );


            setValue(
                "fornecedorCnpj",
                formatarCnpj(cnpj)
            );


            setValue(
                "fornecedorUf",
                uf
            );


            setValue(
                "fornecedorMunicipio",
                municipio
            );

        }


        // =====================================================
        // PRODUTOS
        // =====================================================

        function extrairProdutos(xml) {

            const detalhes =
                xml.querySelectorAll("det");


            const tbody =
                document.getElementById(
                    "fiscalItems"
                );


            if (!tbody) {
                return;
            }


            tbody.innerHTML = "";


            detalhes.forEach(
                function (det) {

                    const produto =
                        det.querySelector("prod");


                    if (!produto) {
                        return;
                    }


                    const codigo =
                        getXmlValue(
                            produto,
                            "cProd"
                        );


                    const descricao =
                        getXmlValue(
                            produto,
                            "xProd"
                        );


                    const ncm =
                        getXmlValue(
                            produto,
                            "NCM"
                        );


                    const cfop =
                        getXmlValue(
                            produto,
                            "CFOP"
                        );


                    const quantidade =
                        getXmlValue(
                            produto,
                            "qCom"
                        );


                    const valorUnitario =
                        getXmlValue(
                            produto,
                            "vUnCom"
                        );


                    const valorTotal =
                        getXmlValue(
                            produto,
                            "vProd"
                        );


                    const icms =
                        extrairIcms(det);


                    adicionarLinhaProduto(
                        tbody,
                        {
                            codigo,
                            descricao,
                            ncm,
                            cfop,
                            quantidade,
                            valorUnitario,
                            valorTotal,
                            icms
                        }
                    );

                }
            );


            calcularTotais(xml);

        }


        // =====================================================
        // ICMS
        // =====================================================

        function extrairIcms(det) {

            const icms =
                det.querySelector("ICMS");


            if (!icms) {
                return null;
            }


            const percentual =
                getXmlValue(
                    icms,
                    "pICMS"
                );


            const valor =
                getXmlValue(
                    icms,
                    "vICMS"
                );


            return {

                percentual: percentual,

                valor: valor

            };

        }


        // =====================================================
        // ADICIONAR LINHA
        // =====================================================

        function adicionarLinhaProduto(
            tbody,
            produto
        ) {

            const tr =
                document.createElement("tr");


            const percentualIcms =
                produto.icms &&
                produto.icms.percentual
                    ? produto.icms.percentual + "%"
                    : "-";


            tr.innerHTML = `

                <td>

                    <div class="product-cell">

                        <div class="product-icon">

                            <i class="bi bi-box-seam"></i>

                        </div>

                        <div>

                            <strong>
                                ${escapeHtml(produto.descricao)}
                            </strong>

                            <span>
                                SKU: ${escapeHtml(produto.codigo)}
                            </span>

                        </div>

                    </div>

                </td>


                <td>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="${escapeHtml(produto.ncm)}" />

                </td>


                <td>

                    <input type="text"
                           class="form-control form-control-sm"
                           value="${escapeHtml(produto.cfop)}" />

                </td>


                <td>

                    <input type="number"
                           class="form-control form-control-sm"
                           value="${escapeHtml(produto.quantidade)}" />

                </td>


                <td>

                    <input type="number"
                           class="form-control form-control-sm"
                           value="${escapeHtml(produto.valorUnitario)}"
                           step="0.01" />

                </td>


                <td>

                    <strong>
                        ${escapeHtml(percentualIcms)}
                    </strong>

                </td>


                <td>

                    <span class="fiscal-status success">

                        <i class="bi bi-check-circle"></i>

                        Importado

                    </span>

                </td>


                <td>

                    <button type="button"
                            class="table-action"
                            onclick="removerProduto(this)">

                        <i class="bi bi-trash"></i>

                    </button>

                </td>

            `;


            tbody.appendChild(tr);

        }


        // =====================================================
        // ADICIONAR PRODUTO MANUALMENTE
        // =====================================================

        function adicionarProduto() {

            const tbody =
                document.getElementById(
                    "fiscalItems"
                );


            const tr =
                document.createElement("tr");


            tr.innerHTML = `

                <td>

                    <div class="product-cell">

                        <div class="product-icon">

                            <i class="bi bi-box"></i>

                        </div>

                        <div>

                            <strong>
                                Novo produto
                            </strong>

                            <span>
                                Inclusão manual
                            </span>

                        </div>

                    </div>

                </td>

                <td>

                    <input type="text"
                           class="form-control form-control-sm"
                           placeholder="NCM" />

                </td>

                <td>

                    <input type="text"
                           class="form-control form-control-sm"
                           placeholder="CFOP" />

                </td>

                <td>

                    <input type="number"
                           class="form-control form-control-sm"
                           value="1" />

                </td>

                <td>

                    <input type="number"
                           class="form-control form-control-sm"
                           value="0"
                           step="0.01" />

                </td>

                <td>
                    -
                </td>

                <td>

                    <span class="fiscal-status">

                        Pendente

                    </span>

                </td>

                <td>

                    <button type="button"
                            class="table-action"
                            onclick="removerProduto(this)">

                        <i class="bi bi-trash"></i>

                    </button>

                </td>

            `;


            tbody.appendChild(tr);

        }


        // =====================================================
        // REMOVER PRODUTO
        // =====================================================

        function removerProduto(button) {

            const row =
                button.closest("tr");


            if (row) {

                row.remove();

            }

        }


        // =====================================================
        // TOTAIS
        // =====================================================

        function calcularTotais(xml) {

            const totalProdutos =
                getXmlValueFromDocument(
                    xml,
                    "vProd"
                );


            const totalIcms =
                getXmlValueFromDocument(
                    xml,
                    "vICMS"
                );


            const totalIpi =
                getXmlValueFromDocument(
                    xml,
                    "vIPI"
                );


            const totalFrete =
                getXmlValueFromDocument(
                    xml,
                    "vFrete"
                );


            const totalNota =
                getXmlValueFromDocument(
                    xml,
                    "vNF"
                );


            setText(
                "totalProdutos",
                formatarMoeda(totalProdutos)
            );


            setText(
                "totalIcms",
                formatarMoeda(totalIcms)
            );


            setText(
                "totalIpi",
                formatarMoeda(totalIpi)
            );


            setText(
                "totalFrete",
                formatarMoeda(totalFrete)
            );


            setText(
                "totalNota",
                formatarMoeda(totalNota)
            );

        }


        // =====================================================
        // PEGAR VALOR NO DOCUMENTO
        // =====================================================

        function getXmlValueFromDocument(
            xml,
            tagName
        ) {

            const elements =
                xml.getElementsByTagNameNS(
                    "*",
                    tagName
                );


            if (!elements.length) {
                return "0";
            }


            return elements[0]
                .textContent
                .trim();

        }


        // =====================================================
        // PEGAR VALOR XML
        // =====================================================

        function getXmlValue(
            parent,
            tagName
        ) {

            const element =
                Array.from(
                    parent.children
                ).find(
                    child =>
                        child.localName === tagName
                );


            if (!element) {
                return "";
            }


            return element.textContent.trim();

        }


        // =====================================================
        // SET VALUE
        // =====================================================

        function setValue(
            id,
            value
        ) {

            const element =
                document.getElementById(id);


            if (element) {

                element.value =
                    value || "";

            }

        }


        // =====================================================
        // SET TEXT
        // =====================================================

        function setText(
            id,
            value
        ) {

            const element =
                document.getElementById(id);


            if (element) {

                element.innerText =
                    value || "R$ 0,00";

            }

        }


        // =====================================================
        // FORMATAR CNPJ
        // =====================================================

        function formatarCnpj(cnpj) {

            if (!cnpj) {
                return "";
            }


            cnpj =
                cnpj.replace(
                    /\D/g,
                    ""
                );


            if (cnpj.length !== 14) {
                return cnpj;
            }


            return cnpj.replace(
                /^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/,
                "$1.$2.$3/$4-$5"
            );

        }


        // =====================================================
        // FORMATAR CHAVE
        // =====================================================

        function formatarChave(chave) {

            if (!chave) {
                return "";
            }


            chave =
                chave.replace(
                    /\D/g,
                    ""
                );


            return chave
                .replace(
                    /(.{4})/g,
                    "$1 "
                )
                .trim();

        }


        // =====================================================
        // FORMATAR MOEDA
        // =====================================================

        function formatarMoeda(valor) {

            const numero =
                parseFloat(
                    String(valor)
                        .replace(",", ".")
                );


            if (isNaN(numero)) {

                return "R$ 0,00";

            }


            return numero.toLocaleString(
                "pt-BR",
                {
                    style: "currency",
                    currency: "BRL"
                }
            );

        }


        // =====================================================
        // ESCAPE HTML
        // =====================================================

        function escapeHtml(value) {

            if (
                value === null ||
                value === undefined
            ) {

                return "";

            }


            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");

        }


        // =====================================================
        // SALVAR
        // =====================================================

        function salvarNota() {

            alert(
                "Nota Fiscal salva como rascunho."
            );

        }


        // =====================================================
        // VALIDAR
        // =====================================================

        function validarNota() {

            const numero =
                document.getElementById(
                    "numeroNota"
                ).value;


            const fornecedor =
                document.getElementById(
                    "fornecedorNome"
                ).value;


            if (!numero) {

                alert(
                    "Informe ou importe o número da NF-e."
                );

                return;

            }


            if (!fornecedor) {

                alert(
                    "Importe um XML válido para identificar o fornecedor."
                );

                return;

            }


            alert(
                "NF-e pronta para a etapa de validação fiscal."
            );

        }


        // =====================================================
        // ANÁLISE FISCAL
        // =====================================================

        function abrirAnaliseFiscal() {

            alert(
                "A análise completa será conectada ao RAG + Qdrant nas próximas etapas."
            );

        }


        // =====================================================
        // DRAG AND DROP
        // =====================================================

        const dropArea =
            document.getElementById(
                "xmlDropArea"
            );


        if (dropArea) {

            dropArea.addEventListener(
                "dragover",
                function(event) {

                    event.preventDefault();

                    dropArea.classList.add(
                        "drag-over"
                    );

                }
            );


            dropArea.addEventListener(
                "dragleave",
                function() {

                    dropArea.classList.remove(
                        "drag-over"
                    );

                }
            );


            dropArea.addEventListener(
                "drop",
                function(event) {

                    event.preventDefault();

                    dropArea.classList.remove(
                        "drag-over"
                    );


                    const files =
                        event.dataTransfer.files;


                    if (!files.length) {
                        return;
                    }


                    const input =
                        document.getElementById(
                            "xmlFile"
                        );


                    /*
                     * Alguns navegadores não permitem
                     * atribuir diretamente files.
                     *
                     * Nesse caso usamos o primeiro
                     * arquivo diretamente.
                     */

                    processarArquivo(
                        files[0]
                    );

                }
            );

        }


        // =====================================================
        // PROCESSAR ARQUIVO
        // =====================================================

        function processarArquivo(file) {

            if (
                !file.name
                    .toLowerCase()
                    .endsWith(".xml")
            ) {

                alert(
                    "Selecione um arquivo XML válido."
                );

                return;

            }


            const reader =
                new FileReader();


            reader.onload =
                function(event) {

                    processarXml(
                        event.target.result,
                        file.name
                    );

                };


            reader.onerror =
                function() {


                    alert(
                        "Erro ao ler o arquivo XML."
                    );

                };


            reader.readAsText(file);

        }

    </script>

}