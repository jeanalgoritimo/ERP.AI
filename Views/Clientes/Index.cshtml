                fantasia: "Epsilon Alimentos",
                avatar: "EA",
                cnpj: "33.444.555/0001-66",
                cidade: "Contagem",
                uf: "MG",
                status: "Ativo",
                limite: "R$ 220.000,00"
            }

        };


        /* =====================================================
           MODAL NOVO CLIENTE
           ===================================================== */

        function abrirModalNovoCliente() {

            const form =
                document.getElementById("formCliente");

            if (form) {
                form.reset();
            }

            const modalElement =
                document.getElementById("modalCliente");

            if (!modalElement) {

                console.error(
                    "Modal modalCliente não encontrado."
                );

                return;
            }

            const modal =
                bootstrap.Modal.getOrCreateInstance(
                    modalElement
                );

            modal.show();
        }


        /* =====================================================
           FILTRAR CLIENTES
           ===================================================== */

        function filtrarClientes() {

            const buscaElement =
                document.getElementById("filtroBusca");

            const statusElement =
                document.getElementById("filtroStatus");

            const estadoElement =
                document.getElementById("filtroEstado");


            const busca =
                buscaElement
                    ? buscaElement.value.toLowerCase().trim()
                    : "";


            const status =
                statusElement
                    ? statusElement.value
                    : "";


            const estado =
                estadoElement
                    ? estadoElement.value
                    : "";


            const linhas =
                document.querySelectorAll(
                    "#clientesTabela tr"
                );


            let quantidade = 0;


            linhas.forEach(function (linha) {

                const texto =
                    (linha.getAttribute("data-search") || "")
                        .toLowerCase();


                const statusCliente =
                    linha.getAttribute("data-status") || "";


                const estadoCliente =
                    linha.getAttribute("data-estado") || "";


                const encontrouTexto =
                    !busca ||
                    texto.includes(busca);


                const encontrouStatus =
                    !status ||
                    statusCliente === status;


                const encontrouEstado =
                    !estado ||
                    estadoCliente === estado;


                if (
                    encontrouTexto &&
                    encontrouStatus &&
                    encontrouEstado
                ) {

                    linha.style.display = "";

                    quantidade++;

                }
                else {

                    linha.style.display = "none";

                }

            });


            const contador =
                document.getElementById(
                    "contadorClientes"
                );


            if (contador) {

                contador.innerText =
                    quantidade +
                    (
                        quantidade === 1
                            ? " cliente"
                            : " clientes"
                    );

            }

        }


        /* =====================================================
           LIMPAR FILTROS
           ===================================================== */

        function limparFiltros() {

            const busca =
                document.getElementById("filtroBusca");

            const status =
                document.getElementById("filtroStatus");

            const estado =
                document.getElementById("filtroEstado");


            if (busca) {
                busca.value = "";
            }

            if (status) {
                status.value = "";
            }

            if (estado) {
                estado.value = "";
            }


            filtrarClientes();

        }


        /* =====================================================
           SALVAR CLIENTE
           ===================================================== */

        function salvarCliente() {

            const razaoSocial =
                document
                    .getElementById("razaoSocial")
                    .value
                    .trim();


            const cnpj =
                document
                    .getElementById("cnpj")
                    .value
                    .trim();


            if (!razaoSocial) {

                alert(
                    "Informe a Razão Social."
                );

                return;
            }


            if (!cnpj) {

                alert(
                    "Informe o CNPJ."
                );

                return;
            }


            alert(
                "Cliente salvo com sucesso!"
            );


            const modalElement =
                document.getElementById(
                    "modalCliente"
                );


            if (modalElement) {

                const modal =
                    bootstrap.Modal.getInstance(
                        modalElement
                    );

                if (modal) {
                    modal.hide();
                }

            }

        }


        /* =====================================================
           VISUALIZAR CLIENTE
           ===================================================== */

        function visualizarCliente(codigo) {

            const cliente =
                clientes[codigo];


            if (!cliente) {

                alert(
                    "Cliente não encontrado."
                );

                return;
            }


            /* ---------------------------------------------
               Preenche cabeçalho
               --------------------------------------------- */

            const avatar =
                document.getElementById(
                    "detalheAvatar"
                );

            const nome =
                document.getElementById(
                    "detalheNome"
                );

            const cnpj =
                document.getElementById(
                    "detalheCnpj"
                );

            const codigoElement =
                document.getElementById(
                    "detalheCodigo"
                );

            const cidade =
                document.getElementById(
                    "detalheCidade"
                );

            const status =
                document.getElementById(
                    "detalheStatus"
                );


            if (avatar) {
                avatar.innerText =
                    cliente.avatar;
            }


            if (nome) {
                nome.innerText =
                    cliente.nome;
            }


            if (cnpj) {
                cnpj.innerText =
                    "CNPJ: " +
                    cliente.cnpj;
            }


            if (codigoElement) {

                codigoElement.innerText =
                    "Código: " +
                    cliente.codigo;

                codigoElement.dataset.codigo =
                    cliente.codigo;
            }


            if (cidade) {

                cidade.innerText =
                    cliente.cidade +
                    " / " +
                    cliente.uf;
            }


            if (status) {

                status.className =
                    "status-badge " +
                    (
                        cliente.status === "Ativo"
                            ? "active"
                            : "inactive"
                    );

                status.innerHTML =
                    '<span class="status-dot"></span>' +
                    cliente.status;
            }


            /* ---------------------------------------------
               Volta para a aba Resumo
               --------------------------------------------- */

            const resumoTab =
                document.getElementById(
                    "resumo-tab"
                );


            if (resumoTab) {

                const tab =
                    bootstrap.Tab.getOrCreateInstance(
                        resumoTab
                    );

                tab.show();

            }


            /* ---------------------------------------------
               Abre modal
               --------------------------------------------- */

            const modalElement =
                document.getElementById(
                    "modalDetalhesCliente"
                );


            if (!modalElement) {

                console.error(
                    "Modal modalDetalhesCliente não encontrado."
                );

                return;
            }


            const modal =
                bootstrap.Modal.getOrCreateInstance(
                    modalElement
                );


            modal.show();

        }


        /* =====================================================
           EDITAR CLIENTE
           ===================================================== */

        function editarCliente(codigo) {

            const cliente =
                clientes[codigo];


            if (!cliente) {

                alert(
                    "Cliente não encontrado."
                );

                return;
            }


            alert(
                "A edição do cliente " +
                cliente.nome +
                " será implementada na próxima etapa."
            );

        }

    </script>

