@{
    ViewData["Title"] = "Clientes";
}

<style>

    /* =========================================================
           PÁGINA
           ========================================================= */

    .clientes-page {
        padding: 24px;
    }

    /* =========================================================
           CABEÇALHO
           ========================================================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 24px;
    }

    .page-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #6c757d;
        margin-bottom: 8px;
    }

        .page-breadcrumb i {
            font-size: 10px;
        }

    .page-title {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: #1f2937;
    }

    .page-subtitle {
        margin: 6px 0 0;
        color: #6b7280;
    }

    .page-actions {
        display: flex;
        gap: 8px;
    }

    /* =========================================================
           CARDS
           ========================================================= */

    .erp-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 22px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,.03);
    }

    /* =========================================================
           FILTROS
           ========================================================= */

    .filter-card {
        padding: 18px 22px;
    }

    .filter-title {
        font-size: 14px;
        font-weight: 700;
        color: #374151;
        margin-bottom: 15px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 6px;
    }

    .form-control,
    .form-select {
        min-height: 40px;
        border-radius: 8px;
        border-color: #d9dee5;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 .2rem rgba(13,110,253,.1);
        }

    /* =========================================================
           TABELA
           ========================================================= */

    .table-card {
        padding: 0;
        overflow: hidden;
    }

    .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 22px;
        border-bottom: 1px solid #e5e7eb;
    }

    .table-header-left h5 {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
        color: #1f2937;
    }

    .table-header-left span {
        display: block;
        margin-top: 3px;
        color: #6b7280;
        font-size: 12px;
    }

    .clients-table {
        margin-bottom: 0;
        vertical-align: middle;
    }

        .clients-table th {
            background: #f8fafc;
            color: #6b7280;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            white-space: nowrap;
            padding: 13px 15px;
        }

        .clients-table td {
            padding: 14px 15px;
            font-size: 13px;
        }

    .client-info {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .client-avatar {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #eaf2ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        flex-shrink: 0;
    }

    .client-info strong {
        display: block;
        color: #1f2937;
        font-size: 13px;
    }

    .client-info span {
        display: block;
        color: #6b7280;
        font-size: 11px;
        margin-top: 2px;
    }

    /* =========================================================
           STATUS
           ========================================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

        .status-badge.active {
            background: #ecfdf3;
            color: #15803d;
        }

        .status-badge.inactive {
            background: #f3f4f6;
            color: #6b7280;
        }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }

    /* =========================================================
           AÇÕES
           ========================================================= */

    .action-buttons {
        display: flex;
        gap: 5px;
    }

    .action-button {
        width: 32px;
        height: 32px;
        border: 0;
        border-radius: 7px;
        background: #f8fafc;
        color: #475569;
        transition: .2s;
    }

        .action-button:hover {
            background: #eaf2ff;
            color: #2563eb;
        }

    /* =========================================================
           RESUMO
           ========================================================= */

    .summary-card {
        height: 100%;
        padding: 18px;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        background: #fff;
    }

    .summary-icon {
        width: 40px;
        height: 40px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
    }

        .summary-icon.blue {
            background: #eaf2ff;
            color: #2563eb;
        }

        .summary-icon.green {
            background: #ecfdf5;
            color: #16a34a;
        }

        .summary-icon.orange {
            background: #fff7ed;
            color: #ea580c;
        }

        .summary-icon.purple {
            background: #f5f3ff;
            color: #7c3aed;
        }

    .summary-value {
        font-size: 22px;
        font-weight: 700;
        color: #1f2937;
    }

    .summary-label {
        font-size: 12px;
        color: #6b7280;
    }

    /* =========================================================
           MODAIS
           ========================================================= */

    .modal-content {
        border: 0;
        border-radius: 15px;
        overflow: hidden;
    }

    .modal-header {
        padding: 20px 24px;
        border-bottom: 1px solid #e5e7eb;
    }

    .modal-title {
        font-size: 18px;
        font-weight: 700;
    }

    .modal-body {
        padding: 24px;
    }

    .modal-footer {
        padding: 16px 24px;
        border-top: 1px solid #e5e7eb;
    }

    .modal-section {
        margin-bottom: 24px;
    }

        .modal-section:last-child {
            margin-bottom: 0;
        }

    .modal-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
    }

    .modal-section-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: #eaf2ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-section-title strong {
        font-size: 14px;
        color: #1f2937;
    }

    .modal-section-title span {
        display: block;
        color: #6b7280;
        font-size: 11px;
    }

    /* =========================================================
           IA / RAG
           ========================================================= */

    .ai-context {
        background: linear-gradient(135deg, #f8fbff, #ffffff);
        border: 1px solid #dbeafe;
        border-radius: 11px;
        padding: 16px;
    }

    .ai-context-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
    }

    .ai-context-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: #eaf2ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ai-context-header strong {
        font-size: 13px;
    }

    .ai-context p {
        margin: 0;
        color: #64748b;
        font-size: 12px;
        line-height: 1.6;
    }

    /* =========================================================
           CABEÇALHO DO MODAL DE DETALHES
           ========================================================= */

    .cliente-detalhe-header {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .cliente-detalhe-avatar {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #eaf2ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 16px;
    }

    .cliente-detalhe-nome {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
        color: #1f2937;
    }

    .cliente-detalhe-info {
        margin-top: 4px;
        font-size: 12px;
        color: #6b7280;
    }

    /* =========================================================
           TABS DO CLIENTE
           ========================================================= */

    .cliente-tabs {
        border-bottom: 1px solid #e5e7eb;
        padding: 0 24px;
        background: #fff;
        overflow-x: auto;
        white-space: nowrap;
    }

        .cliente-tabs .nav-link {
            border: 0;
            border-bottom: 2px solid transparent;
            border-radius: 0;
            color: #64748b;
            font-size: 12px;
            font-weight: 600;
            padding: 15px 14px;
        }

            .cliente-tabs .nav-link:hover {
                color: #2563eb;
            }

            .cliente-tabs .nav-link.active {
                color: #2563eb;
                background: transparent;
                border-bottom-color: #2563eb;
            }

    .cliente-tab-content {
        min-height: 360px;
    }

    /* =========================================================
           CARDS DO DETALHE
           ========================================================= */

    .detail-card {
        height: 100%;
        border: 1px solid #e5e7eb;
        border-radius: 11px;
        padding: 16px;
        background: #fff;
    }

    .detail-card-title {
        font-size: 12px;
        font-weight: 700;
        color: #374151;
        margin-bottom: 12px;
    }

    .detail-label {
        font-size: 11px;
        color: #94a3b8;
        margin-bottom: 3px;
    }

    .detail-value {
        font-size: 13px;
        color: #1f2937;
        font-weight: 600;
    }

    .detail-row {
        padding: 10px 0;
        border-bottom: 1px solid #f1f5f9;
    }

        .detail-row:last-child {
            border-bottom: 0;
        }

    /* =========================================================
           CONTRATOS / DOCUMENTOS / HISTÓRICO
           ========================================================= */

    .info-list-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 13px 0;
        border-bottom: 1px solid #f1f5f9;
    }

        .info-list-item:last-child {
            border-bottom: 0;
        }

    .info-list-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .info-list-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8fafc;
        color: #475569;
    }

    .info-list-title {
        font-size: 12px;
        font-weight: 600;
        color: #1f2937;
    }

    .info-list-subtitle {
        font-size: 10px;
        color: #94a3b8;
        margin-top: 2px;
    }

    /* =========================================================
           IA RAG - MODAL
           ========================================================= */

    .rag-card {
        border: 1px solid #dbeafe;
        background: linear-gradient(135deg, #f8fbff, #ffffff);
        border-radius: 12px;
        padding: 18px;
        margin-bottom: 16px;
    }

    .rag-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
    }

    .rag-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #eaf2ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .rag-title {
        font-size: 14px;
        font-weight: 700;
        color: #1f2937;
    }

    .rag-subtitle {
        font-size: 11px;
        color: #64748b;
        margin-top: 3px;
    }

    .rag-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 9px;
        border-radius: 20px;
        background: #fff7ed;
        color: #c2410c;
        font-size: 10px;
        font-weight: 700;
    }

    .rag-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .rag-placeholder {
        padding: 20px;
        text-align: center;
        border: 1px dashed #bfdbfe;
        border-radius: 10px;
        color: #64748b;
        background: #fff;
    }

        .rag-placeholder i {
            display: block;
            font-size: 28px;
            color: #2563eb;
            margin-bottom: 8px;
        }

        .rag-placeholder strong {
            display: block;
            font-size: 13px;
            color: #334155;
            margin-bottom: 5px;
        }

        .rag-placeholder span {
            display: block;
            font-size: 11px;
            line-height: 1.6;
        }

    /* =========================================================
           RESPONSIVO
           ========================================================= */

    @@media (max-width: 992px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .page-actions {
            width: 100%;
        }

            .page-actions .btn {
                flex: 1;
            }
    }

</style>


<div class="clientes-page">

    <!-- =====================================================
         CABEÇALHO
         ===================================================== -->

    <div class="page-header">

        <div>

            <div class="page-breadcrumb">

                <span>ERP AI</span>

                <i class="bi bi-chevron-right"></i>

                <span>Comercial</span>

                <i class="bi bi-chevron-right"></i>

                <strong>Clientes</strong>

            </div>

            <h1 class="page-title">
                Clientes
            </h1>

            <p class="page-subtitle">
                Gerencie clientes e informações comerciais.
            </p>

        </div>

        <div class="page-actions">

            <button type="button"
                    class="btn btn-light border">

                <i class="bi bi-download me-2"></i>

                Exportar

            </button>

            <button type="button"
                    class="btn btn-primary"
                    onclick="abrirModalNovoCliente()">

                <i class="bi bi-plus-lg me-2"></i>

                Novo Cliente

            </button>

        </div>

    </div>


    <!-- =====================================================
         RESUMO
         ===================================================== -->

    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">

            <div class="summary-card">

                <div class="summary-icon blue">
                    <i class="bi bi-people"></i>
                </div>

                <div class="summary-value">
                    248
                </div>

                <div class="summary-label">
                    Total de clientes
                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="summary-card">

                <div class="summary-icon green">
                    <i class="bi bi-person-check"></i>
                </div>

                <div class="summary-value">
                    231
                </div>

                <div class="summary-label">
                    Clientes ativos
                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="summary-card">

                <div class="summary-icon orange">
                    <i class="bi bi-person-x"></i>
                </div>

                <div class="summary-value">
                    17
                </div>

                <div class="summary-label">
                    Clientes inativos
                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="summary-card">

                <div class="summary-icon purple">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>

                <div class="summary-value">
                    R$ 1,8M
                </div>

                <div class="summary-label">
                    Limite de crédito total
                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         FILTROS
         ===================================================== -->

    <div class="erp-card filter-card">

        <div class="filter-title">

            <i class="bi bi-funnel me-2"></i>

            Filtros

        </div>

        <div class="row g-3">

            <div class="col-lg-5">

                <label class="form-label">
                    Buscar
                </label>

                <div class="input-group">

                    <span class="input-group-text bg-white">

                        <i class="bi bi-search"></i>

                    </span>

                    <input type="text"
                           id="filtroBusca"
                           class="form-control"
                           placeholder="Nome, CNPJ ou código..."
                           onkeyup="filtrarClientes()" />

                </div>

            </div>


            <div class="col-lg-2">

                <label class="form-label">
                    Status
                </label>

                <select id="filtroStatus"
                        class="form-select"
                        onchange="filtrarClientes()">

                    <option value="">
                        Todos
                    </option>

                    <option value="Ativo">
                        Ativo
                    </option>

                    <option value="Inativo">
                        Inativo
                    </option>

                </select>

            </div>


            <div class="col-lg-2">

                <label class="form-label">
                    Estado
                </label>

                <select id="filtroEstado"
                        class="form-select"
                        onchange="filtrarClientes()">

                    <option value="">
                        Todos
                    </option>

                    <option value="MG">
                        MG
                    </option>

                    <option value="SP">
                        SP
                    </option>

                    <option value="RJ">
                        RJ
                    </option>

                    <option value="ES">
                        ES
                    </option>

                </select>

            </div>


            <div class="col-lg-3 d-flex align-items-end">

                <button type="button"
                        class="btn btn-light border w-100"
                        onclick="limparFiltros()">

                    <i class="bi bi-arrow-counterclockwise me-2"></i>

                    Limpar filtros

                </button>

            </div>

        </div>

    </div>


    <!-- =====================================================
         TABELA
         ===================================================== -->

    <div class="erp-card table-card">

        <div class="table-header">

            <div class="table-header-left">

                <h5>
                    Lista de Clientes
                </h5>

                <span>
                    Clientes cadastrados no sistema
                </span>

            </div>

