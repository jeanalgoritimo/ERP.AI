@model ERP.AI.Models.Clientes.ClienteListViewModel

@{
    ViewData["Title"] = "Clientes";
}

@section Styles {
    <link rel="stylesheet" href="~/css/clientes.css" asp-append-version="true" />
}

<div class="clientes-page">
    <div class="clientes-header">
        <div>
            <div class="clientes-breadcrumb">
                <span>ERP AI</span>
                <i class="bi bi-chevron-right"></i>
                <span>Comercial</span>
                <i class="bi bi-chevron-right"></i>
                <strong>Clientes</strong>
            </div>
            <h1>Gestão de clientes</h1>
            <p>Consulte e gerencie a carteira comercial da empresa.</p>
        </div>

        <a asp-action="Criar" class="btn btn-primary clientes-new-button">
            <i class="bi bi-plus-lg"></i>
            Novo cliente
        </a>
    </div>

    @if (TempData["Success"] is string mensagem)
    {
        <div class="alert alert-success alert-dismissible fade show clientes-alert" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@mensagem</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    <div class="clientes-kpis">
        <article class="clientes-kpi clientes-kpi-blue">
            <div class="clientes-kpi-icon"><i class="bi bi-people"></i></div>
            <div>
                <span>Clientes exibidos</span>
                <strong>@Model.Total</strong>
                <small>Registros encontrados</small>
            </div>
        </article>

        <article class="clientes-kpi clientes-kpi-green">
            <div class="clientes-kpi-icon"><i class="bi bi-person-check"></i></div>
            <div>
                <span>Clientes ativos</span>
                <strong>@Model.TotalAtivos</strong>
                <small>Disponíveis para vendas</small>
            </div>
        </article>

        <article class="clientes-kpi clientes-kpi-purple">
            <div class="clientes-kpi-icon"><i class="bi bi-cash-coin"></i></div>
            <div>
                <span>Limite de crédito</span>
                <strong>@Model.LimiteTotal.ToString("C")</strong>
                <small>Total da carteira exibida</small>
            </div>
        </article>
    </div>

    <section class="clientes-card clientes-filter-card">
        <div class="clientes-section-title">
            <div>
                <i class="bi bi-funnel"></i>
                <strong>Filtros</strong>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Busca) || Model.Ativo.HasValue)
            {
                <a asp-action="Index" class="clientes-clear-filter">Limpar filtros</a>
            }
        </div>

        <form method="get" class="clientes-filter-grid">
            <div class="clientes-search-field">
                <label class="form-label" for="busca">Pesquisar cliente</label>
                <div class="clientes-input-icon">
                    <i class="bi bi-search"></i>
                    <input id="busca" name="busca" value="@Model.Busca" class="form-control"
                           placeholder="Código, razão social, fantasia ou documento" />
                </div>
            </div>

            <div>
                <label class="form-label" for="ativo">Status</label>
                <select id="ativo" name="ativo" class="form-select">
                    <option value="">Todos os status</option>
                    @if (Model.Ativo is true)
                    {
                        <option value="true" selected>Ativos</option>
                    }
                    else
                    {
                        <option value="true">Ativos</option>
                    }
                    @if (Model.Ativo is false)
                    {
                        <option value="false" selected>Inativos</option>
                    }
                    else
                    {
                        <option value="false">Inativos</option>
                    }
                </select>
            </div>

            <button class="btn btn-primary clientes-filter-button" type="submit">
                <i class="bi bi-search"></i>
                Aplicar filtros
            </button>
        </form>
    </section>

    <section class="clientes-card clientes-table-card">
        <div class="clientes-table-header">
            <div>
                <h2>Carteira de clientes</h2>
                <p>Exibindo @Model.Total @(Model.Total == 1 ? "cliente" : "clientes")</p>
            </div>
            <span class="clientes-result-badge">@Model.Total resultado(s)</span>
        </div>

        <div class="table-responsive">
            <table class="table clientes-table">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Documento</th>
                        <th>Localização</th>
                        <th>Categoria</th>
                        <th>Limite</th>
                        <th>Status</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Clientes.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                <div class="clientes-empty">
                                    <i class="bi bi-search"></i>
                                    <strong>Nenhum cliente encontrado</strong>
                                    <span>Tente alterar os filtros ou cadastre um novo cliente.</span>
                                </div>
                            </td>
                        </tr>
                    }

                    @foreach (var cliente in Model.Clientes)
                    {
                        var iniciais = string.Concat(cliente.RazaoSocial
                        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                        .Take(2)
                        .Select(parte => char.ToUpperInvariant(parte[0])));

                        <tr>
                            <td>
                                <div class="clientes-identity">
                                    <div class="clientes-avatar">@iniciais</div>
                                    <div>
                                        <strong>@cliente.RazaoSocial</strong>
                                        <span>@cliente.Codigo · @cliente.NomeFantasia</span>
                                    </div>
                                </div>
                            </td>
                            <td><span class="clientes-document">@cliente.Documento</span></td>
                            <td>
                                <div class="clientes-location">
                                    <i class="bi bi-geo-alt"></i>
                                    <span>@cliente.Cidade/@cliente.Estado</span>
                                </div>
                            </td>
                            <td><span class="clientes-category clientes-category-@cliente.Categoria.ToLowerInvariant()">@cliente.Categoria</span></td>
                            <td><strong class="clientes-credit">@cliente.LimiteCredito.ToString("C")</strong></td>
                            <td>
                                <span class="clientes-status @(cliente.Ativo ? "is-active" : "is-inactive")">
                                    <i class="bi bi-circle-fill"></i>
                                    @(cliente.Ativo ? "Ativo" : "Inativo")
                                </span>
                            </td>
                            <td>
                                <div class="clientes-actions">
                                    <a asp-action="Detalhes" asp-route-id="@cliente.Id" class="clientes-action" title="Ver detalhes" aria-label="Ver detalhes de @cliente.RazaoSocial">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Editar" asp-route-id="@cliente.Id" class="clientes-action" title="Editar" aria-label="Editar @cliente.RazaoSocial">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
