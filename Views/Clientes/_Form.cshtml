@model ERP.AI.Models.Clientes.ClienteFormViewModel
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<input asp-for="Id" type="hidden" />
<div class="row g-3">
    <div class="col-md-3"><label asp-for="Codigo" class="form-label"></label><input asp-for="Codigo" class="form-control" /><span asp-validation-for="Codigo" class="text-danger small"></span></div>
    <div class="col-md-5"><label asp-for="RazaoSocial" class="form-label"></label><input asp-for="RazaoSocial" class="form-control" /><span asp-validation-for="RazaoSocial" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="NomeFantasia" class="form-label"></label><input asp-for="NomeFantasia" class="form-control" /><span asp-validation-for="NomeFantasia" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="Documento" class="form-label"></label><input asp-for="Documento" class="form-control" /><span asp-validation-for="Documento" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="Telefone" class="form-label"></label><input asp-for="Telefone" class="form-control" /><span asp-validation-for="Telefone" class="text-danger small"></span></div>
    <div class="col-md-5"><label asp-for="Cidade" class="form-label"></label><input asp-for="Cidade" class="form-control" /></div>
    <div class="col-md-2"><label asp-for="Estado" class="form-label"></label><input asp-for="Estado" class="form-control text-uppercase" maxlength="2" /></div>
    <div class="col-md-2"><label asp-for="Categoria" class="form-label"></label><select asp-for="Categoria" class="form-select"><option>Regular</option><option>Bronze</option><option>Prata</option><option>Ouro</option></select></div>
    <div class="col-md-3"><label asp-for="LimiteCredito" class="form-label"></label><input asp-for="LimiteCredito" class="form-control" /><span asp-validation-for="LimiteCredito" class="text-danger small"></span></div>
    <div class="col-12"><div class="form-check form-switch"><input asp-for="Ativo" class="form-check-input" /><label asp-for="Ativo" class="form-check-label">Cliente ativo</label></div></div>
</div>
