@model ERP.AI.Models.Clientes.ClienteFormViewModel
@{ ViewData["Title"] = "Editar cliente"; }
<div class="page-header"><div><h1 class="page-title">Editar cliente</h1><p class="page-subtitle">Atualize os dados de @Model.RazaoSocial.</p></div></div>
<form asp-action="Editar" asp-route-id="@Model.Id" method="post" class="erp-card">
    <partial name="_Form" model="Model" />
    <div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Index" class="btn btn-light border">Cancelar</a><button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Salvar alterações</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
