<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ERP AI</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet">

    <!-- CSS da aplicação -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <div class="erp-wrapper">

        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">

            <!-- Logo -->
            <div class="sidebar-brand">

                <div class="brand-icon">
                    <i class="bi bi-robot"></i>
                </div>

                <div class="brand-text">
                    <span class="brand-title">ERP</span>
                    <span class="brand-subtitle">AI Platform</span>
                </div>

            </div>

            <!-- Menu -->
            <nav class="sidebar-menu">

                <div class="menu-section">
                    PRINCIPAL
                </div>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="menu-item active">

                    <i class="bi bi-grid-1x2-fill"></i>

                    <span>Dashboard</span>

                </a>


                <div class="menu-section">
                    COMERCIAL
                </div>

                <a asp-controller="Vendas"
                   asp-action="Pedido"
                   class="menu-item">

                    <i class="bi bi-cart3"></i>

                    <span>Pedidos de Venda</span>

                </a>

                <a href="#" class="menu-item">

                    <i class="bi bi-people"></i>

                    <span>Clientes</span>

                </a>

                <a href="#" class="menu-item">

                    <i class="bi bi-tags"></i>

                    <span>Cotações</span>

                </a>


                <div class="menu-section">
                    FISCAL
                </div>

                <a href="#" class="menu-item">

                    <i class="bi bi-receipt"></i>

                    <span>Notas Fiscais</span>

                </a>


                <div class="menu-section">
                    FINANCEIRO
                </div>

                <a href="#" class="menu-item">

                    <i class="bi bi-cash-stack"></i>

                    <span>Contas a Receber</span>

                </a>

                <a href="#" class="menu-item">

                    <i class="bi bi-wallet2"></i>

                    <span>Contas a Pagar</span>

                </a>


                <div class="menu-section">
                    INTELIGÊNCIA
                </div>

                <a href="#" class="menu-item">

                    <i class="bi bi-stars"></i>

                    <span>Assistente IA</span>

                    <span class="ai-badge">
                        AI
                    </span>

                </a>

                <a href="#" class="menu-item">

                    <i class="bi bi-file-earmark-text"></i>

                    <span>Base de Conhecimento</span>

                </a>

            </nav>


            <!-- Rodapé -->
            <div class="sidebar-footer">

                <a href="#" class="menu-item">

                    <i class="bi bi-gear"></i>

                    <span>Configurações</span>

                </a>

            </div>

        </aside>


        <!-- ÁREA PRINCIPAL -->
        <div class="main-area">


            <!-- TOPBAR -->
            <header class="topbar">

                <div class="topbar-left">

                    <button class="sidebar-toggle"
                            type="button"
                            onclick="toggleSidebar()">

                        <i class="bi bi-list"></i>

                    </button>

                    <div class="page-context">

                        <span class="context-label">
                            ERP AI
                        </span>

                        <span class="context-separator">
                            /
                        </span>

                        <span class="context-current">
                            @ViewData["Title"]
                        </span>

                    </div>

                </div>


                <div class="topbar-right">

                    <!-- Status IA -->
                    <div class="ai-status">

                        <span class="status-dot"></span>

                        <span>IA Online</span>

                    </div>


                    <!-- Notificações -->
                    <button class="topbar-button">

                        <i class="bi bi-bell"></i>

                        <span class="notification-badge">
                            3
                        </span>

                    </button>


                    <!-- Usuário -->
                    <div class="user-profile">

                        <div class="user-avatar">
                            JS
                        </div>

                        <div class="user-info">

                            <strong>
                                Usuário ERP
                            </strong>

                            <small>
                                Administrador
                            </small>

                        </div>

                        <i class="bi bi-chevron-down user-arrow"></i>

                    </div>

                </div>

            </header>


            <!-- CONTEÚDO -->
            <main class="content-area">

                @RenderBody()

            </main>


            <!-- FOOTER -->
            <footer class="erp-footer">

                <span>
                    ERP AI Platform
                </span>

                <span>
                    v1.0.0
                </span>

            </footer>

        </div>

    </div>


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <!-- JS da aplicação -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>