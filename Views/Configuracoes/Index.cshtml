@{ ViewData["Title"] = "Configurações"; }
<div class="module-page">
    <header class="module-header"><div><div class="module-breadcrumb"><span>ERP AI</span><i class="bi bi-chevron-right"></i><strong>Configurações</strong></div><h1>Configurações</h1><p>Administre preferências, integrações e parâmetros da plataforma.</p></div><button class="btn btn-primary module-primary"><i class="bi bi-check-lg"></i>Salvar alterações</button></header>
    <div class="settings-layout"><nav class="module-card settings-nav"><button class="active" data-settings="empresa"><i class="bi bi-building"></i>Empresa</button><button data-settings="ia"><i class="bi bi-stars"></i>Inteligência artificial</button><button data-settings="seguranca"><i class="bi bi-shield-lock"></i>Segurança</button><button data-settings="notificacoes"><i class="bi bi-bell"></i>Notificações</button><button data-settings="integracoes"><i class="bi bi-plug"></i>Integrações</button></nav>
    <section class="module-card settings-content"><div class="settings-title"><div><h2>Dados da empresa</h2><p>Informações exibidas nos documentos e relatórios do ERP.</p></div><span class="module-status success">Ambiente ativo</span></div><div class="settings-form"><div class="span-2"><label class="form-label">Razão social</label><input class="form-control" value="ERP AI Tecnologia Ltda." /></div><div><label class="form-label">CNPJ</label><input class="form-control" value="12.345.678/0001-90" /></div><div><label class="form-label">Inscrição estadual</label><input class="form-control" value="123.456.789" /></div><div><label class="form-label">E-mail administrativo</label><input type="email" class="form-control" value="admin@erp-ai.demo" /></div><div><label class="form-label">Telefone</label><input class="form-control" value="(27) 3333-2026" /></div><div><label class="form-label">Moeda</label><select class="form-select"><option>BRL — Real brasileiro</option></select></div><div><label class="form-label">Fuso horário</label><select class="form-select"><option>America/Sao_Paulo</option></select></div></div><hr /><div class="settings-title"><div><h2>Ambiente de demonstração</h2><p>Recursos apropriados para estudo e apresentação no portfólio.</p></div></div><div class="settings-options"><label><span><strong>Dados demonstrativos</strong><small>Carregar registros fictícios ao iniciar</small></span><input type="checkbox" class="form-check-input" checked /></label><label><span><strong>Modo RAG demonstrativo</strong><small>Responder sem exigir chave de API</small></span><input type="checkbox" class="form-check-input" checked /></label><label><span><strong>Exibir evidências</strong><small>Mostrar as fontes usadas pelo assistente</small></span><input type="checkbox" class="form-check-input" checked /></label></div></section></div>
</div>
@section Scripts { <script>document.querySelectorAll('[data-settings]').forEach(button => button.addEventListener('click', () => { document.querySelectorAll('[data-settings]').forEach(item => item.classList.remove('active')); button.classList.add('active'); }));</script> }
